# Cycle 1's own analysis warehouse. Never evorove-crm's DATABASE_URL, never
# evorove's -- three separate Postgres instances. See docker-compose.yml
# for the local port (5435; 5433 is evorove-crm, 5434 is evorove).
#
# Copy to .env, fill in locally. Never commit .env. The engine falls back to
# a no-op warehouse when this is unset, so tests and local runs work without it.
DATABASE_URL=postgresql+psycopg://evorove_lead:local_development_only@localhost:5435/evorove_lead

# Optional: cycle 1 -> CRM Cold handoff (see crm_touch.py). Unset means the
# engine only computes candidates locally and never reaches CRM.
CRM_BASE_URL=
INTERNAL_TASK_SECRET=
