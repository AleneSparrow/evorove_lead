# Cycle 1's own analysis warehouse. Never evorove-crm's DATABASE_URL, never
# evorove's -- three separate Postgres instances. See docker-compose.yml
# for the local port (5435; 5433 is evorove-crm, 5434 is evorove).
#
# Copy to .env, fill in locally. Never commit .env. The engine falls back to
# a no-op warehouse when this is unset, so tests and local runs work without it.
DATABASE_URL=postgresql+psycopg://evorove_lead:local_development_only@localhost:5435/evorove_lead

# Optional: cycle 1 -> CRM Cold handoff (see crm_touch.py), AND the shared
# secret this repo's own inbound endpoint (api.py) checks on the way back
# in (phase 3's hypothesis_id -> outcome event from cycle 2/3). Same secret,
# both directions. Unset means: no outbound CRM touch, and the inbound
# endpoint refuses every request.
CRM_BASE_URL=
INTERNAL_TASK_SECRET=

# Optional: the phase-2 real PeopleSearch connector (web_search.py +
# web_people_search.py). Point this at a metasearch endpoint you run
# yourself (e.g. a self-hosted SearxNG instance: https://docs.searxng.org/)
# that returns {"results": [{"url": ..., "content": ...}, ...]} JSON --
# never a paid third-party search API. Unset means the engine has no live
# connector and generation reports SEARCH_UNCONNECTED.
WEB_SEARCH_BASE_URL=
